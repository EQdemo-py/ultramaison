<div class="um-payment-trust">

  <div class="um-payment-trust__title">
    Formas de pago disponibles
  </div>

  <div class="um-payment-trust__methods">

    <div class="um-payment-logo">
      {{ 'visa' | payment_type_svg_tag }}
    </div>

    <div class="um-payment-logo">
      {{ 'master' | payment_type_svg_tag }}
    </div>

    <div class="um-payment-logo">
      {{ 'american_express' | payment_type_svg_tag }}
    </div>

  </div>

  <div class="um-payment-trust__list">

    <div class="um-payment-trust__item">
      <span class="um-payment-trust__check">✓</span>
      <span>Productos originales</span>
    </div>

    <div class="um-payment-trust__item">
      <span class="um-payment-trust__check">✓</span>
      <span>Garantía oficial de marca</span>
    </div>

    <div class="um-payment-trust__item">
      <span class="um-payment-trust__check">✓</span>
      <span>Compra segura y protegida</span>
    </div>

  </div>

</div>
