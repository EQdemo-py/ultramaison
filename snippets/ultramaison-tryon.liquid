{% liquid
  assign tryon_image = product.metafields.custom.tryon_image.value

  if tryon_image == blank
    assign tryon_image = product.metafields.custom.imagen_para_probador_virtual.value
  endif
%}

{% if tryon_image != blank %}
  {{ 'ultramaison-tryon.css' | asset_url | stylesheet_tag }}
  <script
    type="module"
    src="{{ 'ultramaison-ar-engine.js' | asset_url }}"
  ></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('[data-ultramaison-tryon]').forEach(function(root) {
        var openButton = root.querySelector('[data-tryon-open]');
        var modal = root.querySelector('[data-tryon-modal]');
        var closeButton = root.querySelector('[data-tryon-close]');
        var guide = root.querySelector('.um-tryon-modal__guide');

        if (!openButton || !modal) return;

        openButton.addEventListener('click', function () {
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';

          if (guide) {
            guide.textContent = 'AR V3 UI activa · preparando motor 3D...';
          }

          window.dispatchEvent(
            new CustomEvent('ultramaison:ar-open', {
              detail: { root: root }
            })
          );
        });

        closeButton?.addEventListener('click', function () {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';

          window.dispatchEvent(
            new CustomEvent('ultramaison:ar-close', {
              detail: { root: root }
            })
          );
        });
      });
    });
  </script>


  {% assign tryon_diameter = product.metafields.custom.diametro_de_caja_mm.value | default: 40 %}

  <div
    class="um-tryon"
    data-ultramaison-tryon
    data-watch-diameter="{{ tryon_diameter }}"
  >

    <button
      type="button"
      class="um-tryon__button"
      data-tryon-open
    >
      PROBALO EN TU MUÑECA · AR V3
    </button>

    <p class="um-tryon__note">
      Usá la cámara para visualizar este reloj en tu muñeca.
    </p>

    <div
      class="um-tryon-modal"
      data-tryon-modal
      aria-hidden="true"
    >
      <div class="um-tryon-modal__stage">

        <video
          data-tryon-video
          autoplay
          playsinline
          muted
        ></video>

        <img
          class="um-tryon-modal__watch"
          data-tryon-watch
          src="{{ tryon_image | image_url: width: 1000 }}"
          alt="{{ product.title | escape }}"
          width="1000"
          height="1000"
        >

        <div class="um-tryon-modal__topbar">
          <span>{{ product.title }}</span>

          <button
            type="button"
            class="um-tryon-modal__close"
            data-tryon-close
            aria-label="Cerrar probador virtual"
          >
            ×
          </button>
        </div>

        <div class="um-tryon-modal__guide">
          AR V3 CARGADO · Tocá el botón para iniciar
        </div>

      </div>
    </div>

  </div>

{% elsif request.design_mode %}

  <div style="
    margin:20px 0;
    padding:14px;
    border:1px dashed #0d1d4f;
    font-size:12px;
  ">
    ULTRAMAISON Try-On activo, pero no encuentra la imagen del metacampo.
  </div>

{% endif %}
