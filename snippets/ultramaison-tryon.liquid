{% assign tryon_image = product.metafields.custom.tryon_image.value %}

{% if tryon_image != blank %}
  {{ 'ultramaison-tryon.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ultramaison-tryon.js' | asset_url }}" defer></script>

  <div
    class="um-tryon"
    data-ultramaison-tryon
  >
    <button
      type="button"
      class="um-tryon__button"
      data-tryon-open
    >
      Probalo en tu muñeca
    </button>

    <p class="um-tryon__note">
      Usá la cámara de tu celular para visualizar este reloj en tu muñeca.
    </p>

    <div
      class="um-tryon-modal"
      data-tryon-modal
      aria-hidden="true"
    >
      <div class="um-tryon-modal__stage">

        <video
          data-tryon-video
          playsinline
          muted
        ></video>

        <img
          class="um-tryon-modal__watch"
          data-tryon-watch
          src="{{ tryon_image | image_url: width: 800 }}"
          alt="{{ product.title | escape }}"
        >

        <div class="um-tryon-modal__topbar">
          <span class="um-tryon-modal__title">
            {{ product.title }}
          </span>

          <button
            type="button"
            class="um-tryon-modal__close"
            data-tryon-close
            aria-label="Cerrar"
          >
            ×
          </button>
        </div>

        <div class="um-tryon-modal__guide">
          Colocá tu muñeca frente a la cámara.
          El reloj se ajustará automáticamente en la siguiente etapa.
        </div>

        <div
          class="um-tryon-modal__error"
          data-tryon-error
        >
          <div>
            <strong>No pudimos acceder a la cámara.</strong>
            <p>
              Revisá los permisos de cámara de tu navegador e intentá nuevamente.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
{% endif %}
